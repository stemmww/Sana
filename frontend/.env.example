BACKEND_URL=http://127.0.0.1:8000
# Server-only key: copy the value from the backend .env into .env.local.
# Never use VITE_API_KEY: variables with VITE_ prefix are public.
API_KEY=replace-with-your-generated-key
# Match MAX_UPLOAD_MB on the backend. The backend enforces the actual limit.
VITE_MAX_UPLOAD_MB=100
