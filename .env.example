# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=replace-with-your-generated-key
STORAGE_DIR=data
MAX_UPLOAD_MB=100
# Optional total multipart body cap; defaults to MAX_UPLOAD_MB + 1 MiB.
# Must be strictly greater than MAX_UPLOAD_MB.
MAX_REQUEST_MB=101
# Enable after installing CV dependencies and local weights; start app.worker separately.
# ANALYZER_CALLABLE=app.cv.worker_adapter:analyze_video
SANA_DEVICE=auto
SANA_EVENT_CONFIG=config/event_camera_service.json
JOB_TIMEOUT_SECONDS=240
# Total budget from HTTP upload request arrival, including upload and queue wait.
TOTAL_JOB_TIMEOUT_SECONDS=300
# Upload reservations + queued + running jobs, shared through SQLite.
MAX_ACTIVE_JOBS=5
MAX_RUNNING_JOBS=1
WORKER_POLL_SECONDS=1
# Cleanup runs inside the API; the CLI can also run one pass explicitly.
CLEANUP_ENABLED=true
JOB_RETENTION_SECONDS=86400
ORPHAN_GRACE_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=100

